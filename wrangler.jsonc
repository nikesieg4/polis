{
  // Name muss mit dem Worker-Namen im Cloudflare-Dashboard übereinstimmen.
  "name": "polis",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Nicht geheime Discord-Werte. Client Secret und Bot-Token als Secret im Dashboard anlegen.
  "vars": {
    "DISCORD_CLIENT_ID": "1573745208791670795",
    "DISCORD_GUILD_ID": "1573743287645376684"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "polis-db",
      "database_id": "b91846e9-bb77-47f8-af8f-bd579416f7fb"
    }
  ]
}
